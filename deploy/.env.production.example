# Copy to deploy/.env on the production box and fill in real values.
# Never commit deploy/.env — it is gitignored.

# --- Service -----------------------------------------------------------------
UPSTREAM_PORT=4000
UPSTREAM_ENVIRONMENT=production
UPSTREAM_LOG_LEVEL=INFO
UPSTREAM_ALLOWED_ORIGINS=https://upstreamcv.com,https://app.upstreamcv.com

# --- Supabase (Project Settings → API + Project Settings → Database) ---------
UPSTREAM_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
UPSTREAM_SUPABASE_ANON_KEY=PASTE_FROM_DASHBOARD
UPSTREAM_SUPABASE_SERVICE_ROLE_KEY=PASTE_FROM_DASHBOARD
UPSTREAM_SUPABASE_JWT_SECRET=PASTE_FROM_DASHBOARD

# Direct Postgres connection. Use 5432 for long-running servers (this one).
UPSTREAM_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Internal signing keys (generate fresh on first deploy; rotate later) ----
# python -c "import secrets;print(secrets.token_urlsafe(32))"
UPSTREAM_SESSION_JWT_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_STREAMID_HMAC_KEY=GENERATE_32_BYTE_URLSAFE

# --- Shared secrets with sister services ------------------------------------
UPSTREAM_MEDIAMTX_WEBHOOK_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_PROCESSOR_WEBHOOK_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_PROMETHEUS_AUTH_TOKEN=GENERATE_32_BYTE_URLSAFE

# --- SRT ingest endpoint advertised to agents in `srt_url` -------------------
# Defaults to ingest.upstreamcv.com:18890 in src/upstream_api/config.py — set
# these only if a deployment needs to point at a different streaming server
# (e.g. a local box for dev).
# UPSTREAM_SRT_INGEST_HOST=ingest.upstreamcv.com
# UPSTREAM_SRT_INGEST_PORT=18890

# --- MediaMTX WHEP proxy (dashboard live playback) ---------------------------
# The api-server forwards browser SDP offers to MediaMTX's WHEP endpoint at
# this URL. MUST be reachable only from the api-server — MediaMTX's read path
# has no native auth; we firewall it instead. The default in config.py is
# `http://localhost:8889`, which is wrong for any non-laptop deploy.
#
# Production firewall posture (REQUIRED): MediaMTX's 8889/tcp, 8554/tcp, and
# 9997/tcp must be reachable ONLY from the api-server's egress IP. 8189/udp
# stays public for ICE media. See
# upstream-streaming-server/docs/stream-auth.md (Read-path auth section).
#
# Examples:
#   Docker-compose network:  UPSTREAM_MEDIAMTX_BASE_URL=http://upstream-streaming-server:8889
#   SSH-tunnel to remote:    UPSTREAM_MEDIAMTX_BASE_URL=http://127.0.0.1:8889
#   Private VPC DNS:         UPSTREAM_MEDIAMTX_BASE_URL=http://streaming.internal:8889
UPSTREAM_MEDIAMTX_BASE_URL=http://upstream-streaming-server:8889

# --- Perception fan-out hot path (optional) ----------------------------------
# Live detection overlays at 10–15 Hz via the perception-fanout sidecar in
# upstream-streaming-server. Leave both unset to disable: the stream-token
# endpoint then 503s (perception_stream_not_configured) and the dashboard
# stays on its Realtime + polling fallback.
#
# UPSTREAM_FANOUT_TOKEN_SECRET must MATCH the sidecar's
# UPSTREAM_FANOUT_TOKEN_SECRET (this server mints subscriber tokens, the
# sidecar verifies). UPSTREAM_FANOUT_PUBLIC_WS_URL is the browser-reachable
# base of the sidecar — production terminates wss:// at the ingest box's
# Caddy, which proxies /perception/* to 127.0.0.1:18990 (deploy checklist in
# upstream-streaming-server/docs/perception-fanout.md).
UPSTREAM_FANOUT_TOKEN_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_FANOUT_PUBLIC_WS_URL=wss://ingest.upstreamcv.com/perception
# UPSTREAM_FANOUT_TOKEN_TTL_SECONDS=600

# --- Sentry (optional) ------------------------------------------------------
UPSTREAM_SENTRY_DSN=
