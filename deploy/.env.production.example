# Copy to deploy/.env on the production box and fill in real values.
# Never commit deploy/.env — it is gitignored.

# --- Service -----------------------------------------------------------------
UPSTREAM_PORT=4000
UPSTREAM_ENVIRONMENT=production
UPSTREAM_LOG_LEVEL=INFO
UPSTREAM_ALLOWED_ORIGINS=https://upstreamcv.com,https://app.upstreamcv.com

# --- Supabase (Project Settings → API + Project Settings → Database) ---------
UPSTREAM_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
UPSTREAM_SUPABASE_ANON_KEY=PASTE_FROM_DASHBOARD
UPSTREAM_SUPABASE_SERVICE_ROLE_KEY=PASTE_FROM_DASHBOARD
UPSTREAM_SUPABASE_JWT_SECRET=PASTE_FROM_DASHBOARD

# Direct Postgres connection. Use 5432 for long-running servers (this one).
UPSTREAM_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Internal signing keys (generate fresh on first deploy; rotate later) ----
# python -c "import secrets;print(secrets.token_urlsafe(32))"
UPSTREAM_SESSION_JWT_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_STREAMID_HMAC_KEY=GENERATE_32_BYTE_URLSAFE

# --- Shared secrets with sister services ------------------------------------
UPSTREAM_MEDIAMTX_WEBHOOK_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_PROCESSOR_WEBHOOK_SECRET=GENERATE_32_BYTE_URLSAFE
UPSTREAM_PROMETHEUS_AUTH_TOKEN=GENERATE_32_BYTE_URLSAFE

# --- SRT ingest endpoint advertised to agents in `srt_url` -------------------
# Must point at whichever upstream-streaming-server / MediaMTX node this
# environment routes ingest through. Dev/staging usually point at a single
# operator-run box; prod points at the public ingest hostname.
UPSTREAM_SRT_INGEST_HOST=ingest.upstreamcv.com
UPSTREAM_SRT_INGEST_PORT=8890

# --- Sentry (optional) ------------------------------------------------------
UPSTREAM_SENTRY_DSN=
