# Server
UPSTREAM_PORT=4000
UPSTREAM_ENVIRONMENT=development
UPSTREAM_LOG_LEVEL=INFO

# Supabase project (from Project Settings → API in the Supabase dashboard)
UPSTREAM_SUPABASE_URL=https://your-project.supabase.co
UPSTREAM_SUPABASE_ANON_KEY=your-anon-key
UPSTREAM_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
UPSTREAM_SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Direct Postgres connection (from Project Settings → Database → Connection string)
# Use direct port 5432 for long-running servers (this API), pooled 6543 for serverless.
UPSTREAM_DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Internal signing keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
UPSTREAM_SESSION_JWT_SECRET=replace-with-32-byte-random
UPSTREAM_STREAMID_HMAC_KEY=replace-with-32-byte-random

# Shared secrets with sister services
UPSTREAM_MEDIAMTX_WEBHOOK_SECRET=replace-with-32-byte-random
UPSTREAM_PROCESSOR_WEBHOOK_SECRET=replace-with-32-byte-random
UPSTREAM_PROMETHEUS_AUTH_TOKEN=replace-with-32-byte-random
# Module 6 M6.3: symmetric key for encrypting webhook destination signing
# secrets at rest (pgcrypto). Required to create webhook destinations.
UPSTREAM_WEBHOOK_SECRET_ENC_KEY=replace-with-32-byte-random

# CORS allowlist (comma-separated)
UPSTREAM_ALLOWED_ORIGINS=http://localhost:3000

# Perception fan-out hot path (optional). Unset = stream-token endpoint 503s
# and the dashboard stays on Realtime + polling. The token secret must MATCH
# the perception-fanout sidecar's UPSTREAM_FANOUT_TOKEN_SECRET
# (upstream-streaming-server); the ws URL points at that sidecar's
# host-published port for local dev.
UPSTREAM_FANOUT_TOKEN_SECRET=replace-with-32-byte-random
UPSTREAM_FANOUT_PUBLIC_WS_URL=ws://127.0.0.1:18990

# Sentry (optional)
UPSTREAM_SENTRY_DSN=

# --- Agent version policy (update M2, notify-only; all optional) -----------
# Set at least one of LATEST/MIN to ship agent_version_policy on bootstrap.
# UPSTREAM_AGENT_LATEST_VERSION=0.1.0
# UPSTREAM_AGENT_MIN_SUPPORTED_VERSION=
# UPSTREAM_AGENT_UPDATE_SEVERITY_HINT=recommended
# UPSTREAM_AGENT_RELEASE_NOTES_URL=https://github.com/UpstreamCV/upstream-agent/releases
# UPSTREAM_AGENT_INSTALL_HINT=pip install --upgrade upstream-agent
